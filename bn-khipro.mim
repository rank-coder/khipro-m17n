		("=" "=")
		("=f" "≠")
	)
	(prithayok
		(";" ";")
	)
	(fuser
		("/" (set FuserID 1) "/")
		("//" (set FuserID 2) "/")
		("///" (set FuserID 3) "/")
		("/f" (set FuserID 4) "/⁌")
	)
	(backspace
		( (BackSpace)  (undo) )
	)
	(lowercaseIdentity
		("a" "a")
		("b" "b")
		("c" "c")
		("d" "d")
		("e" "e")
		("f" "f")
