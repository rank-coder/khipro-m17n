		("gf" (set CnstID 4) (set Fflag 1) (set CmpdCnstFlag 0) "ঘ")
		("ng" (set CnstID 5) (set CmpdCnstFlag 1) "ঙ")
		("c" (set CnstID 6) (set CmpdCnstFlag 0) "চ")
		("ch" (set CnstID 7) (set CmpdCnstFlag 1) (set Fflag 0) "ছ")
		("cf" (set CnstID 7) (set Fflag 1) (set CmpdCnstFlag 0) "ছ")
		("j" (set CnstID 8) (set CmpdCnstFlag 0) "জ")
		("jh" (set CnstID 9) (set CmpdCnstFlag 1) (set Fflag 0) "ঝ")
		("jf" (set CnstID 9) (set Fflag 1) (set CmpdCnstFlag 0) "ঝ")
		("nff" (set CnstID 10) (set CmpdCnstFlag 0) "ঞ")
		("mf" (set CnstID 10) (set CmpdCnstFlag 0) "ঞ")
		("tf" (set CnstID 11) (set CmpdCnstFlag 0) "ট")
		("tff" (set CnstID 12) (set CmpdCnstFlag 0) "ঠ")
		("df" (set CnstID 13) (set CmpdCnstFlag 0) "ড")
		("dff" (set CnstID 14) (set CmpdCnstFlag 0) "ঢ")
		("nf" (set CnstID 15) (set CmpdCnstFlag 0) "ণ")
		("t" (set CnstID 16) (set CmpdCnstFlag 0) "ত")
		("th" (set CnstID 17) (set CmpdCnstFlag 1) "থ")
		("d" (set CnstID 18) (set CmpdCnstFlag 0) "দ")
