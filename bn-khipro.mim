		("\\" "\\")
		("|" "|")
	)
	(blinder
		("\\" "\\")
		("?" "?")
	)
)

(state
	(init
		(t (set CmpdCnstFlag 0) (set Fflag 0) (set Cnst2 0) (set ALTERNATE 0) (set Cnst1 0) (set Cnst3 0) (set Cnst4 0) (set CnstID 0) (set SLASH 0) (set KAR 0) (set CnstBufr 0))
		(diacritic (commit)  (shift shor_state))
		(fuser
			(cond
				((= FuserID 1) (commit))
				((= FuserID 2) (delete @-) (insert "ঁ") (shift shor_state))
				((= FuserID 3) (insert "/") (commit))
				((= FuserID 4) (commit))
			)
		)
		(shor (shift shor_state))
		(fkar (commit)  (shift shor_state))
		(prithayok (commit) )
		(ongko )
		(biram (shift shor_state)) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(byanjon
			(set Cnst1 CnstID) (set CnstBufr 1) (mark cstm1) (shift byanjon_state)
		)
		;; VARIABLE Cnst1 অর্থ: কোনো ব্যঞ্জন লেখামাত্র সেটার ID -কে Cnst1 তে সেভ করা হয় (P অর্থ previous ধরতে পারি)। Cnst2 হচ্ছে তার পরের ব্যঞ্জনের ID.
		;; কোনো যুক্তবর্ণ গঠিত হলে সেই যুক্তব‍র্ণের আলাদা CnstID সেট করা হবে। সেটাকে সাথে সাথে Cnst1 তে পাসও করে দেওয়া হবে। এতে পরব‍র্তী ব্যঞ্জন এই যুক্তবর্ণের সাথে যুক্ত হবে কিনা সিদ্ধান্ত নেওয়া যাবে।
		(blinder (shift blind_state))
	)
	(shor_state
		(t (set CmpdCnstFlag 0) (set Fflag 0) (set Cnst2 0) (set ALTERNATE 0) (set Cnst1 0) (set Cnst3 0) (set Cnst4 0) (set CnstID 0) (set SLASH 0) (set KAR 0) (set CnstBufr 0))
		(diacritic  )
		(fuser
			(cond
				((= FuserID 2) (commit))
				((= FuserID 1) (delete @-) (insert "ঁ") (shift shor_state))
				((= FuserID 3) (insert "/") (commit))
				((= FuserID 4) (commit))
			)
		)
		(shor )
		(fkar )
		(biram ) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(prithayok (delete @-)  (shift init) )
		(ongko (shift init))
		(byanjon
			(set Cnst1 CnstID) (set CnstBufr 1) (mark cstm1) (shift byanjon_state)
		)
		(blinder (shift blind_state))
		(backspace)
	)
	(byanjon_state
		(prithayok (delete @-)  (shift init))
		(ongko  (shift init))
		(biram  (shift shor_state)) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(kar
			(cond
				( (& (| (= Cnst1 27) (= Cnst1 187)) (= KAR 1)) (move @-) (move @-) (move @-) (insert "‍") (move @>) (set KAR 0) )  ;; র, রর ইত্যাদিতে অ্যা কার দেওয়ার জন্য
			)
			(shift shor_state)
		)
		(byanjon
			(cond
				((= CnstBufr 0)
					(set Cnst1 CnstID) (set CnstBufr 1) (mark cstm1)
				)
				((= CnstBufr 1)
					(set Cnst2 Cnst1) (set Cnst1 CnstID) (set CnstBufr 2)
					(move cstm1) (mark cstm2) (move @>) (mark cstm1)
				)
				((= CnstBufr 2)
					(set Cnst3 Cnst2) (set Cnst2 Cnst1) (set Cnst1 CnstID) (set CnstBufr 3)
					(move cstm2) (mark cstm3) (move cstm1) (mark cstm2) (move @>) (mark cstm1)
				)
				((= CnstBufr 3)
					(set Cnst4 Cnst3) (set Cnst3 Cnst2) (set Cnst2 Cnst1) (set Cnst1 CnstID) (set CnstBufr 4)
					(move cstm3) (mark cstm4) (move cstm2) (mark cstm3) (move cstm1) (mark cstm2) (move @>) (mark cstm1)
				)
				((= CnstBufr 4)
					(set Cnst4 Cnst3) (set Cnst3 Cnst2) (set Cnst2 Cnst1) (set Cnst1 CnstID) (set CnstBufr 4)
					(move cstm3) (mark cstm4) (move cstm2) (mark cstm3) (move cstm1) (mark cstm2) (move @>) (mark cstm1)
				)
			)

			(cond
				((& (= Cnst2 187) (> Cnst1 0) ) (move @-) (delete @-) (insert ?্) (move @>)  (reset_cnst_buffer_after_cnjnct)) ;; রর এর পরে কোনো ব্যঞ্জনবর্ণ লিখলে সেটা রেফ তৈরি করবে কোনো মডিফায়ার ছাড়াই
				((& (= Cnst2 27) (= Cnst1 190)) (form_jo_phola) (reset_cnst_buffer_after_cnjnct))
			)
		)
		(fuser
			(cond
				( (& (> CnstBufr 1)(= FuserID 1))
					(cond
						((& (= Cnst2 1) (= Cnst1 2)) (delete cstm2) (delete @-) (insert "ক্ষ") (set CnstID 39) (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 1) (= Cnst1 30)) (move cstm2) (insert ?্) (move @>) (delete @-) (set CnstID 39) (reset_cnst_buffer_after_cnjnct))

						((& (= Cnst2 3) (= Cnst1 15)) (delete cstm2) (delete @-) (insert "গ্‌ণ") (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 3) (= Cnst1 23)) (delete cstm2) (delete @-) (insert "গ্‌ব") (reset_cnst_buffer_after_cnjnct))

						((& (= Cnst2 15) (= Cnst1 20)) (delete cstm2) (delete @-) (insert "ণ্ণ") (reset_cnst_buffer_after_cnjnct))

						((& (= Cnst2 16) (= Cnst1 11)) (delete cstm2) (delete @-) (insert "ট্ট") (reset_cnst_buffer_after_cnjnct))

						((& (= Cnst2 18) (= Cnst1 3)) (delete cstm2) (delete @-) (insert "দ্‌গ") (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 18) (= Cnst1 4)) (delete cstm2) (delete @-) (insert "দ্‌ঘ") (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 18) (= Cnst1 13)) (delete cstm2) (delete @-) (insert "ড্ড") (reset_cnst_buffer_after_cnjnct))

						((& (= Cnst2 20) (= Cnst1 6)) (delete cstm2) (delete @-) (insert "ঞ্চ") (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 20) (= Cnst1 7)) (delete cstm2) (delete @-) (insert "ঞ্ছ") (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 20) (= Cnst1 8)) (delete cstm2) (delete @-) (insert "ঞ্জ") (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 20) (= Cnst1 9)) (delete cstm2) (delete @-) (insert "ঞ্ঝ") (reset_cnst_buffer_after_cnjnct))
						((& (= Cnst2 20) (= Cnst1 15)) (delete cstm2) (delete @-) (insert "ণ্ণ") (reset_cnst_buffer_after_cnjnct))

