	(blinder
		("\\" "\\")
		("?" "?")
	)
)

(state
	(init
		(t (set CmpdCnstFlag 0) (set Fflag 0) (set ScndCnstID 0) (set PrvCnstID 0) (set ALTERNATE 0) (set FrstCnstID 0) (set CnstID 0) (set SLASH 0) (set KAR 0))
		(diacritic (commit)  (shift shor_state))
		(khondo_to (shift init))
		(juktoborno_bunon (commit))
		(slash3 (commit))
		(slash2 (delete @-) (insert "ঁ") (shift shor_state))
		(shor (shift shor_state))
		(fkar (commit)  (shift shor_state))
		(prithayok (commit) )
		(ongko )
		(biram (shift shor_state)) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(byanjon
			(set PrvCnstID FrstCnstID) (set FrstCnstID CnstID)
			(shift byanjon_state)
			(cond
				((= CnstID 0) (shift init))
			)
		)
		;; VARIABLE FrstCnstID অর্থ: কোনো ব্যঞ্জন লেখামাত্র সেটার ID -কে FrstCnstID তে সেভ করা হয় (P অর্থ previous ধরতে পারি)। ScndCnstID হচ্ছে তার পরের ব্যঞ্জনের ID.
		;; কোনো যুক্তবর্ণ গঠিত হলে সেই যুক্তব‍র্ণের আলাদা CnstID সেট করা হবে। সেটাকে সাথে সাথে FrstCnstID তে পাসও করে দেওয়া হবে। এতে পরব‍র্তী ব্যঞ্জন এই যুক্তবর্ণের সাথে যুক্ত হবে কিনা সিদ্ধান্ত নেওয়া যাবে।
		(blinder (shift blind_state))
	)
	(shor_state
		(t (set CmpdCnstFlag 0) (set Fflag 0) (set ScndCnstID 0) (set PrvCnstID 0) (set ALTERNATE 0) (set FrstCnstID 0) (set CnstID 0) (set SLASH 0) (set KAR 0))
		(diacritic  )
		(khondo_to (shift init))
		(juktoborno_bunon (delete @-) (insert "ঁ"))
		(slash2 (shift init))
		(slash3 (shift init))
		(shor )
		(fkar )
		(biram ) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(prithayok (delete @-)  (shift init) )
		(ongko (shift init))
		(byanjon
			(set PrvCnstID FrstCnstID) (set FrstCnstID CnstID)
			(shift byanjon_state)
			(cond
				((= CnstID 0) (shift init))
			)
		)
		(blinder (shift blind_state))
		(backspace)
	)
	(byanjon_state
		(prithayok (delete @-)  (shift init))
		(ongko  (shift init))
		(biram  (shift shor_state)) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(kar
			(cond
				( (& (| (= FrstCnstID 27) (= FrstCnstID 187)) (= KAR 1)) (move @-) (move @-) (move @-) (insert "‍") (move @>) (set KAR 0) )  ;; র, রর ইত্যাদিতে অ্যা কার দেওয়ার জন্য
			)
			(shift shor_state)
		)
		(phola
			
		)
		(byanjon
			(cond
				((= ScndCnstID 0) (set PrvCnstID FrstCnstID) (set ScndCnstID CnstID))
				(1 (set PrvCnstID FrstCnstID) (set FrstCnstID ScndCnstID) (set ScndCnstID CnstID))
			)
			
			(cond
				((& (= FrstCnstID 187) (> ScndCnstID 0) ) (move @-) (delete @-) (insert ?্) (move @>) (set SLASH 1)) ;; রর, য
			)
		)
		(juktoborno_bunon
			(cond
			((> ScndCnstID 0)
				(delete @-)
				(cond
					((= FrstCnstID 1) ;; ক
						(cond
							((= ScndCnstID 1) (delete @-2) (set ScndCnstID CnstID) (set CnstID 38) (insert "ক্ক") (set SLASH 1) (shift juktoborno_state)) ;; ক

							((= ScndCnstID 2) (delete @-2) (set ScndCnstID CnstID) (set CnstID 39) (insert "ক্ষ") (set SLASH 3) (set ALTERNATE 1) (shift juktoborno_state)) ;; খ
							((= ScndCnstID 11) (delete @-2) (set ScndCnstID CnstID) (set CnstID 40) (insert "ক্ট") (set SLASH 1) (shift juktoborno_state)) ;; ট
							((= ScndCnstID 16) (delete @-2) (set ScndCnstID CnstID) (set CnstID 41) (insert "ক্ত") (set SLASH 1) (shift juktoborno_state)) ;; ত
							((= ScndCnstID 23) (delete @-2) (set ScndCnstID CnstID) (set CnstID 42) (insert "ক্ব") (set SLASH 1) (shift juktoborno_state)) ;; ব
							((= ScndCnstID 25) (delete @-2) (set ScndCnstID CnstID) (set CnstID 43) (insert "ক্ম") (set SLASH 1) (shift juktoborno_state)) ;; ম
							((= ScndCnstID 30) (delete @-2) (set ScndCnstID CnstID) (set CnstID 39) (insert "ক্ষ") (set SLASH 1) (shift juktoborno_state)) ;; ষ
							((= ScndCnstID 28) (delete @-2) (set ScndCnstID CnstID) (set CnstID 44) (insert "ক্ল") (set SLASH 1) (shift juktoborno_state)) ;; ল
							((= ScndCnstID 31) (delete @-2) (set ScndCnstID CnstID) (set CnstID 45) (insert "ক্স") (set SLASH 1) (shift juktoborno_state)) ;; স
							((= ScndCnstID 189) (delete @-2) (set ScndCnstID CnstID) (set CnstID 39) (insert "ক্ষ")) ;; ⁌
							((= ScndCnstID 32) (delete @-2) (set ScndCnstID CnstID) (set CnstID 2) (insert "খ")) ;; হ
							((= ScndCnstID 26) (form_jo_phola))
							((= ScndCnstID 27) (form_ro_phola))
							(1 (form_generic_juktoborno))
						)
					)
					((= FrstCnstID 3) ;; গ
						(cond
							((= ScndCnstID 3) (delete @-2) (set ScndCnstID CnstID) (set CnstID 65) (insert "জ্ঞ") (set SLASH 3) (set ALTERNATE 2) (shift juktoborno_state)) ;; গ
							((= ScndCnstID 15) (delete @-2) (set ScndCnstID CnstID) (set CnstID 46) (insert "গ্‌ণ") (set SLASH 2) (shift juktoborno_state)) ;; ণ
							((= ScndCnstID 19) (delete @-2) (set ScndCnstID CnstID) (set CnstID 47) (insert "গ্ধ") (set SLASH 1) (shift juktoborno_state)) ;; ধ
							;; ক্ষ -এর মত গ্ধ -কে ব্যঞ্জনবর্ণের মর্যাদা দেওয়ার প্রয়োজন নেই, কেননা এর ম্যাপিং ব্যতিক্রম নয়।
