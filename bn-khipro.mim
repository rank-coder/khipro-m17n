		("p" (set CnstID 21) (set CmpdCnstFlag 0) "প")
		("ph" (set CnstID 22) (set CmpdCnstFlag 1) (set Fflag 0) "ফ")
		("pf" (set CnstID 22) (set Fflag 1) (set CmpdCnstFlag 0) "ফ")
		("f" (set CnstID 189) (set CmpdCnstFlag 0) "⁌")
		("b" (set CnstID 23) (set CmpdCnstFlag 0) "ব")
		("bf" (set CnstID 24) (set Fflag 1) (set CmpdCnstFlag 0) "ভ")
		("v" (set CnstID 24) (set CmpdCnstFlag 0) (set Fflag 0) "ভ")
		("m" (set CnstID 25) (set CmpdCnstFlag 0) "ম")
		("z" (set CnstID 26) (set CmpdCnstFlag 0) "য")
		("r" (set CnstID 27) (set CmpdCnstFlag 0) "র")
		("l" (set CnstID 28) (set CmpdCnstFlag 0) "ল")
		("sh" (set CnstID 29) (set CmpdCnstFlag 1) "শ")
		("sf" (set CnstID 30) (set CmpdCnstFlag 0) "ষ")
		("s" (set CnstID 31) (set CmpdCnstFlag 0) "স")
		("h" (set CnstID 32) (set CmpdCnstFlag 0) (set Fflag 0) "হ")
		("y" (set CnstID 33) (set CmpdCnstFlag 0) "য়")
		("rf" (set CnstID 34) (set CmpdCnstFlag 0) "ড়")
		("rff" (set CnstID 35) (set CmpdCnstFlag 0) "ঢ়")
		(",," (set CnstID 36) (set CmpdCnstFlag 0) "়")
		;; কিছু বিশেষ যুক্তবর্ণ যাদেরকে ব্যঞ্জনবর্ণের মর্যাদা দেওয়া হলো
		("kf" (set CnstID 39) (set CmpdCnstFlag 0) "ক্ষ")
		("zf" (set CnstID 190) (set CmpdCnstFlag 0) "্য")
		("rr" (set CnstID 187) (set CmpdCnstFlag 1) "রর")
		("gg" (set CmpdCnstFlag 1) (set Cnst1 3) (set Cnst2 3) "জ্ঞ")
	)
	(kar
		("o" "")
		("of" "অ")
		("off" "ঽ")
		("a" "া")
		("af" "আ")
		("i" "ি")
		("if" "ই")
		("ii" "ী")
		("iif" "িই")
		("u" "ু")
		("uf" "উ")
		("uu" "ূ")
		("uuf" "ঊ")
		("q" "ৃ")
		("qf" "ঋ")
		("e" "ে")
		("ef" "এ")
		("wi" "ৈ")
		("wif" "োই")
		("w" "ো")
		("wf" "ও")
		("wu" "ৌ")
		("wuf" "োউ")
		("ae" (set KAR 1) "্যা")
		("aef" "অ্যা")
		("uff" "‌ু")
		("uuff" "‌ূ")
		("qff" "‌ৃ")
		("we" "োয়ে")
		("wef" "ওয়ে")
		("waf" "ওয়া")
		("wa" "োয়া")
		("wae" "ওয়্যা")
		("oo" "ঃ")

	)
	(ongko
		(".1" ".১")
		(".2" ".২")
		(".3" ".৩")
		(".4" ".৪")
		(".5" ".৫")
		(".6" ".৬")
		(".7" ".৭")
		(".8" ".৮")
		(".9" ".৯")
		(".0" ".০")

		("1" "১")
		("2" "২")
		("3" "৩")
		("4" "৪")
		("5" "৫")
		("6" "৬")
		("7" "৭")
		("8" "৮")
		("9" "৯")
		("0" "০")

		("1." "১.")
		("2." "২.")
		("3." "৩.")
		("4." "৪.")
		("5." "৫.")
		("6." "৬.")
		("7." "৭.")
		("8." "৮.")
		("9." "৯.")
		("0." "০.")

		("1.." "১।")
		("2.." "২।")
		("3.." "৩।")
		("4.." "৪।")
		("5.." "৫।")
		("6.." "৬।")
		("7.." "৭।")
		("8.." "৮।")
		("9.." "৯।")
		("0.." "০।")
	)
	(diacritic
		("qq" "্")
		("xx" "্‌")
		("x" "ং")
		("`" "`")
		("``" "‌")
		("```" "``")
		("``f" "‍")
	)
	(khondo_to
	)
	(biram
		("." "।")
		(".." ".")
		("..." "..")
		("...." "...")
		("....." "....")
		("......" ".....")
		("......." "......")
		("\\\\" "\\")
		("$" "৳")
		("$f" "₹")
		(",,," ",,")
		(".f" "॥")
		(".ff" "৺")
		("+" "+")
		("-" "-")
		("+f" "×")
		("-f" "÷")
		("$$" "$")
		("=" "=")
		("=f" "≠")
	)
	(prithayok
		(";" ";")
	)
	(juktoborno_bunon
		("/" "/")
	)
	(slash2
		("//" "/")
	)
	(slash3
		("///" "/")
	)
	(slashModified
		("/f" "/⁌")
	)
	(backspace
		( (BackSpace)  (undo) )
	)
	(lowercaseIdentity
		("a" "a")
		("b" "b")
		("c" "c")
		("d" "d")
		("e" "e")
		("f" "f")
		("g" "g")
		("h" "h")
