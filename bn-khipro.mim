(macro
	(reset_cnst_buffer_after_cnjnct
		(move @>) (mark cstm1) (mark cstm2) (mark cstm3) (mark cstm4) (set Cnst1 CnstID) (set Cnst2 0) (set Cnst3 0) (set Cnst4 0) (set CnstBufr 1)
	)
	(form_jo_phola
		(cond
			((& (= Cnst2 27)(= Cnst1 26)) (move @-) (insert "‍্") (move @>)) ;; র‍্য
			((& (= Cnst2 27)(= Cnst1 190)) (move @-) (delete @-) (insert "‍্") (move @>)) ;; zf র‍্য
			(1 (move @-) (insert "্") (move @>))
		)
	)
