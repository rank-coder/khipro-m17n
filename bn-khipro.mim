		("y" (set CnstID 33) (set CmpdCnstFlag 0) "য়")
		("rf" (set CnstID 34) (set CmpdCnstFlag 0) "ড়")
		("rff" (set CnstID 35) (set CmpdCnstFlag 0) "ঢ়")
		(",," (set CnstID 36) (set CmpdCnstFlag 0) "়")
		;; কিছু বিশেষ যুক্তবর্ণ যাদেরকে ব্যঞ্জনবর্ণের মর্যাদা দেওয়া হলো
		("kf" (set CnstID 39) (set CmpdCnstFlag 0) "ক্ষ")
		("zf" (set CnstID 190) (set CmpdCnstFlag 0) (reset_cnst_buffer_after_cnjnct) "্য")
		("rr" (set CnstID 187) (set CmpdCnstFlag 1) "রর")
		("gg" (set CnstID 188) (set CmpdCnstFlag 1) (set Cnst1 3) (set Cnst2 3) "জ্ঞ")
	)
	(kar
		("o" "")
		("of" "অ")
		("off" "ঽ")
		("a" "া")
		("af" "আ")
		("i" "ি")
		("if" "ই")
		("ii" "ী")
		("iif" "িই")
		("u" "ু")
		("uf" "উ")
		("uu" "ূ")
		("uuf" "ঊ")
		("q" "ৃ")
		("qf" "ঋ")
		("e" "ে")
		("ef" "এ")
		("wi" "ৈ")
		("wif" "োই")
		("w" "ো")
		("wf" "ও")
		("wu" "ৌ")
		("wuf" "োউ")
		("ae" (set KAR 1) "্যা")
		("aef" "অ্যা")
		("uff" "‌ু")
		("uuff" "‌ূ")
		("qff" "‌ৃ")
		("we" "োয়ে")
		("wef" "ওয়ে")
		("waf" "ওয়া")
		("wa" "োয়া")
		("wae" "ওয়্যা")
		("oo" "ঃ")

	)
	(ongko
		(".1" ".১")
		(".2" ".২")
		(".3" ".৩")
		(".4" ".৪")
		(".5" ".৫")
		(".6" ".৬")
		(".7" ".৭")
