		("=" "=")
		("+" "+")
		("[" "[")
		("]" "]")
		("{" "{")
		("}" "}")

		(":" ":")
		("'" "'")
		("\"" "\"")
		("," ",")
		("." ".")
		("<" "<")
		(">" ">")
		("/" "/")
		("?" "?")
		("`" "`")
		("~" "~")
		("\\" "\\")
		("|" "|")
	)
	(blinder
		("\\" "\\")
		("?" "?")
	)
)

(state
	(init
		(t (set CmpdCnstFlag 0) (set Fflag 0) (set Cnst2 0) (set ALTERNATE 0) (set Cnst1 0) (set CnstID 0) (set SLASH 0) (set KAR 0) (set CnstBufr 0))
		(diacritic (commit)  (shift shor_state))
		(khondo_to (shift init))
		(juktoborno_bunon (commit))
		(slash3 (commit))
		(slash2 (delete @-) (insert "ঁ") (shift shor_state))
		(shor (shift shor_state))
		(fkar (commit)  (shift shor_state))
		(prithayok (commit) )
		(ongko )
		(biram (shift shor_state)) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(byanjon
			(set Cnst1 CnstID) (set CnstBufr 1) (shift byanjon_state)
		)
		;; VARIABLE Cnst1 অর্থ: কোনো ব্যঞ্জন লেখামাত্র সেটার ID -কে Cnst1 তে সেভ করা হয় (P অর্থ previous ধরতে পারি)। Cnst2 হচ্ছে তার পরের ব্যঞ্জনের ID.
		;; কোনো যুক্তবর্ণ গঠিত হলে সেই যুক্তব‍র্ণের আলাদা CnstID সেট করা হবে। সেটাকে সাথে সাথে Cnst1 তে পাসও করে দেওয়া হবে। এতে পরব‍র্তী ব্যঞ্জন এই যুক্তবর্ণের সাথে যুক্ত হবে কিনা সিদ্ধান্ত নেওয়া যাবে।
		(blinder (shift blind_state))
	)
	(shor_state
		(t (set CmpdCnstFlag 0) (set Fflag 0) (set Cnst2 0) (set ALTERNATE 0) (set Cnst1 0) (set CnstID 0) (set SLASH 0) (set KAR 0))
		(diacritic  )
		(khondo_to (shift init))
		(juktoborno_bunon (delete @-) (insert "ঁ"))
		(slash2 (shift init))
		(slash3 (shift init))
		(shor )
		(fkar )
		(biram ) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(prithayok (delete @-)  (shift init) )
		(ongko (shift init))
		(byanjon
			(set Cnst1 CnstID) (set CnstBufr 1) (shift byanjon_state)
		)
		(blinder (shift blind_state))
		(backspace)
	)
	(byanjon_state
		(prithayok (delete @-)  (shift init))
		(ongko  (shift init))
		(biram  (shift shor_state)) ;; কারণ, যাতে বিরামের মাঝে পৃথায়ক ব্যবহার করা যায়।
		(kar
			(cond
				( (& (| (= Cnst1 27) (= Cnst1 187)) (= KAR 1)) (move @-) (move @-) (move @-) (insert "‍") (move @>) (set KAR 0) )  ;; র, রর ইত্যাদিতে অ্যা কার দেওয়ার জন্য
			)
			(shift shor_state)
		)
		(byanjon
			(cond
				((= CnstBufr 1) (set Cnst2 CnstID) (set CnstBufr 2))
				((= CnstBufr 2) (set Cnst3 CnstID) (set CnstBufr 3))
				((= CnstBufr 3) (set Cnst4 CnstID) (set CnstBufr 4)) 
				((= CnstBufr 4) (set Cnst1 Cnst2) (set Cnst2 Cnst3) (set Cnst3 Cnst4) (set Cnst4 CnstID))
			)
			
			(cond
				((& (= Cnst1 187) (> Cnst2 0) ) (move @-) (delete @-) (insert ?্) (move @>) (set Cnst1 Cnst2) (set Cnst2 0) (set CnstBufr 1)) ;; রর
			)
		)
		(juktoborno_bunon
			(cond
				((> Cnst2 0)
					(delete @-)
					(cond
						((= Cnst1 1) ;; ক
							(cond
								((= Cnst2 1) (delete @-2) (set CnstID 38) (insert "ক্ক") (set SLASH 1) (shift juktoborno_state)) ;; ক

								((= Cnst2 2) (delete @-2) (set CnstID 39) (insert "ক্ষ") (set SLASH 3) (set ALTERNATE 1) (shift juktoborno_state)) ;; খ
								((= Cnst2 11) (delete @-2) (set CnstID 40) (insert "ক্ট") (set SLASH 1) (shift juktoborno_state)) ;; ট
								((= Cnst2 16) (delete @-2) (set CnstID 41) (insert "ক্ত") (set SLASH 1) (shift juktoborno_state)) ;; ত
								((= Cnst2 23) (delete @-2) (set CnstID 42) (insert "ক্ব") (set SLASH 1) (shift juktoborno_state)) ;; ব
								((= Cnst2 25) (delete @-2) (set CnstID 43) (insert "ক্ম") (set SLASH 1) (shift juktoborno_state)) ;; ম
								((= Cnst2 30) (delete @-2) (set CnstID 39) (insert "ক্ষ") (set SLASH 1) (shift juktoborno_state)) ;; ষ
								((= Cnst2 28) (delete @-2) (set CnstID 44) (insert "ক্ল") (set SLASH 1) (shift juktoborno_state)) ;; ল
								((= Cnst2 31) (delete @-2) (set CnstID 45) (insert "ক্স") (set SLASH 1) (shift juktoborno_state)) ;; স
								((= Cnst2 189) (delete @-2) (set CnstID 39) (insert "ক্ষ")) ;; ⁌
								((= Cnst2 32) (delete @-2) (set CnstID 2) (insert "খ")) ;; হ
								((= Cnst2 26) (form_jo_phola))
								((= Cnst2 27) (form_ro_phola))
								(1 (form_generic_juktoborno))
							)
						)
						((= Cnst1 3) ;; গ
							(cond
								((= Cnst2 3) (delete @-3) (set CnstID 175) (insert "গ্‌গ") (set SLASH 3) (set ALTERNATE 2) (shift juktoborno_state)) ;; গ
								((= Cnst2 15) (delete @-2) (set CnstID 46) (insert "গ্‌ণ") (set SLASH 2) (shift juktoborno_state)) ;; ণ
								((= Cnst2 19) (delete @-2) (set CnstID 47) (insert "গ্ধ") (set SLASH 1) (shift juktoborno_state)) ;; ধ
								;; ক্ষ -এর মত গ্ধ -কে ব্যঞ্জনবর্ণের মর্যাদা দেওয়ার প্রয়োজন নেই, কেননা এর ম্যাপিং ব্যতিক্রম নয়।
								((= Cnst2 20) (delete @-2) (set CnstID 48) (insert "গ্ন") (set SLASH 1) (shift juktoborno_state)) ;; ন
								((= Cnst2 23) (delete @-2) (set CnstID 49) (insert "গ্‌ব") (set SLASH 2) (shift juktoborno_state)) ;; ব
								;; গ + ব -এর গ্‌ব এই রূপটি বাঞ্ছিত আর গ্ব এই রূপটি বাঞ্ছিত না। গ্ব লিখতে gqqb লিখতে হবে।
								((= Cnst2 25) (delete @-2) (set CnstID 50) (insert "গ্ম") (set SLASH 1) (shift juktoborno_state)) ;; ম
